#!/usr/bin/env bash

set -euo pipefail

# Official list of every Julia release, maintained by the Julia team.
VERSIONS_URL="https://julialang-s3.julialang.org/bin/versions.json"

function sort_versions() {
  sed 'h; s/[+-]/./g; s/.p\([[:digit:]]\)/.z\1/; s/$/.z/; G; s/\n/ /' | \
    LC_ALL=C sort -gt. -k 1,1 -k 2,2n -k 3,3n -k 4,4n -k 5,5n | awk '{arr[NR]=$0} END {for (i=NR; i>0; i--) {split(arr[i], a, " "); print a[2]}}'
}

# Top-level keys of versions.json are the version numbers, e.g. `  "1.13.2": {`.
versions=($(curl -fsSL "$VERSIONS_URL" | sed -n 's/^  "\([^"]*\)": {.*/\1/p' | sort_versions))

length=$(( ${#versions[@]} - 1 ))
for (( i=length; i >=0; i-- ))
do
    echo -n "${versions[i]} "
done
echo nightly
